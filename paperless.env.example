# Copy to paperless.env and adjust. Never commit paperless.env.

PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_DBHOST=db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change-me
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=set-your-own-long-random-value
PAPERLESS_TIME_ZONE=Europe/Zurich
PAPERLESS_OCR_LANGUAGE=deu+eng
PAPERLESS_URL=http://localhost:8000

# --- Cloud-storage specific settings ---

# Do not create a second (PDF/A) copy of every document. The original is
# served instead. Halves the offloaded volume. Options: auto | always | never
PAPERLESS_ARCHIVE_FILE_GENERATION=never

# The sanity checker reads EVERY file to verify checksums — on a cloud-backed
# store that downloads the entire collection. Disable the scheduled run
# (you can still run `document_sanity_checker` manually when needed).
PAPERLESS_SANITY_TASK_CRON=disable

# Only needed if the consume/ directory is also cloud-backed:
# inotify does not see changes made from outside on a FUSE mount.
#PAPERLESS_CONSUMER_POLLING_INTERVAL=60
#PAPERLESS_CONSUMER_STABILITY_DELAY=15
