# Copy to .env and adjust (wizard.sh creates this for you if missing).

# Base directory prepared by setup.sh. Must match what you passed to it.
BASE_DIR=/srv/paperless

# Upper bound for the local VFS cache (recently used documents kept on disk).
# Enforced about once per minute — bursts can temporarily exceed it.
VFS_CACHE_MAX=1G

# Only needed when using paperless.yml (new installation).
PAPERLESS_DBPASS=change-me
PAPERLESS_PORT=8000
