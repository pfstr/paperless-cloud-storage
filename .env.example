# Copy to .env and adjust. Used by both compose files.

# Base directory prepared by setup.sh. Must match what you passed to it.
BASE_DIR=/srv/paperless

# Login for the rclone web GUI. Pick a long random password — whoever reaches
# this UI can read your cloud credentials and create mounts.
RCLONE_GUI_USER=admin
RCLONE_GUI_PASS=change-me-to-something-long

# Only needed when using compose/paperless.yml (new installation).
PAPERLESS_DBPASS=change-me-too
PAPERLESS_PORT=8000
